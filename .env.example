# NextAuth Configuration
#NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# GitHub OAuth App Credentials
# Create a GitHub OAuth App at: https://github.com/settings/developers
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_APP_WEBHOOK_SECRET=your-github-app-webhook-secret
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
NEXT_PUBLIC_GITHUB_APP_CLIENT_ID=your-next-public-github-app-client-id


GITHUB_ID=your-github-id
GITHUB_SECRET=your-github-secret

# Supabase Configuration
# Create a Supabase project at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-next-public-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-next-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supbase-service-role key


OPENAI_API_KEY=your-openai-api-key

# Node.js DNS Configuration (fixes fetch issues with IPv6)
NODE_OPTIONS="--dns-result-order=ipv4first"

# Groq API Key (get from https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key
